# ── API Keys ──────────────────────────────────────────────
# Set USE_MOCK=true to run entirely on mock data (no API keys needed)
USE_MOCK=true

# CricketData.org / CricAPI
CRICKET_API_KEY=your_cricket_api_key_here

# API-Sports (covers football, hockey, basketball, volleyball, rugby, baseball)
API_SPORTS_KEY=your_api_sports_key_here

# football-data.org (alternative football provider)
FOOTBALL_DATA_KEY=your_football_data_key_here

# TheSportsDB (free tier available)
THESPORTSDB_KEY=1

# ── Server Config ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Cache TTLs (seconds) ─────────────────────────────────
CACHE_TTL_LIVE=25
CACHE_TTL_FIXTURES=300

# ── Feature Flags ─────────────────────────────────────────
ENABLE_AI_ASSISTANT=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
